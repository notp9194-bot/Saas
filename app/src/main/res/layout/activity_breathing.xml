<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/bg_page">

    <ImageView
        android:layout_width="match_parent" android:layout_height="200dp"
        android:layout_alignParentBottom="true" android:alpha="0.55" android:scaleType="fitXY"
        android:src="@drawable/bg_wave" />

    <ImageView android:id="@+id/btn_back"
        android:layout_width="44dp" android:layout_height="44dp"
        android:layout_margin="16dp" android:padding="10dp"
        android:src="@drawable/ic_back" android:tint="@color/text_dark" />
    <ImageView android:id="@+id/btn_pause"
        android:layout_width="44dp" android:layout_height="44dp"
        android:layout_alignParentEnd="true" android:layout_margin="16dp"
        android:background="@drawable/bg_circle_purple" android:padding="12dp"
        android:src="@drawable/ic_pause" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="80dp" android:gravity="center_horizontal"
        android:orientation="vertical">
        <TextView android:id="@+id/tv_title"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Breathe In" android:textColor="@color/text_dark"
            android:textSize="32sp" android:textStyle="bold" />
        <TextView android:id="@+id/tv_sub"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:text="Slowly..."
            android:textColor="@color/text_gray" android:textSize="17sp" />

        <FrameLayout android:layout_width="260dp" android:layout_height="260dp"
            android:layout_marginTop="36dp">
            <View android:layout_width="match_parent" android:layout_height="match_parent"
                android:background="@drawable/bg_circle_purple" />
            <FrameLayout android:id="@+id/inner"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:layout_margin="26dp" android:background="@drawable/bg_circle_purple"
                android:backgroundTint="@color/lavender_soft">
                <ImageView android:id="@+id/icon"
                    android:layout_width="84dp" android:layout_height="84dp"
                    android:layout_gravity="center" android:src="@drawable/ic_lungs" />
            </FrameLayout>
            <com.breathe.app.CircularProgressView android:id="@+id/ring"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:layout_margin="14dp" />
        </FrameLayout>

        <TextView android:id="@+id/tv_count"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="4"
            android:textColor="@color/text_dark" android:textSize="46sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="seconds" android:textColor="@color/text_dark" android:textSize="17sp" />
        <TextView android:id="@+id/tv_pattern"
            android:layout_width="wrap_content" android:layout_height="40dp"
            android:layout_marginTop="22dp" android:background="@drawable/bg_icon_container"
            android:gravity="center" android:paddingEnd="26dp" android:paddingStart="26dp"
            android:text="4 - 4 - 4 - 4" android:textColor="@color/text_dark"
            android:textSize="15sp" android:textStyle="bold" />
    </LinearLayout>

    <ProgressBar android:id="@+id/bar" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="6dp"
        android:layout_alignParentBottom="true" android:layout_margin="28dp"
        android:max="1000" android:progressTint="@color/purple_primary"
        android:progressBackgroundTint="@color/lavender" android:progressBackgroundTintMode="src_in" />
</RelativeLayout>
